# Production contact delivery endpoint. Receives a JSON POST body.
CONTACT_WEBHOOK_URL=

# Public canonical origin used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://arctoslaunchpad.com

# Public HTTPS form endpoint used by static hosts such as GitHub Pages.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public mailbox used by the "Ask a question first" and "Careers, press, or
# suppliers" doors on /contact (mailto: links). Set this to a real inbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Direct email delivery (takes priority over CONTACT_WEBHOOK_URL).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# Optional: a sender on a domain verified in Resend, e.g.
# "Arctos Launchpad <hello@arctoslaunchpad.com>". When set, enquiries are sent
# from it and each visitor gets an instant confirmation email.
CONTACT_FROM_EMAIL=

# Meta (Facebook/Instagram) ads pixel ID, from Events Manager. Public by design.
# Empty keeps the pixel off. When set, every marketing page (not /hq) loads it,
# and a sent enquiry or teardown request counts as a "Lead".
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads tag ("AW-…") and the lead conversion's label (after the slash in
# its send_to). Public by design. Empty ID keeps the tag off; with both set, a
# sent enquiry or teardown request counts as a Google Ads conversion.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
